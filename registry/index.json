        }
      },
      "data": {
        "in": [
          {
            "field": "images",
            "kind": "bb",
            "description": "JPEG/PNG bytes. Optional if texts is given."
          },
          {
            "field": "texts",
            "kind": "ss",
            "description": "Prompts. Optional if images is given."
          }
        ],
        "out": [
          {
            "field": "image_emb",
            "codec": "numpy",
            "shape": "(num_images, D)",
            "when": "images sent",
            "description": "float32; D depends on the model (512 for ViT-B-32). Unit length unless normalize=false."
          },
          {
            "field": "text_emb",
            "codec": "numpy",
            "shape": "(num_texts, D)",
            "when": "texts sent",
            "description": "float32, same space as image_emb."
          },
          {
            "field": "similarity",
            "codec": "numpy",
            "shape": "(num_images, num_texts)",
            "when": "images and texts sent",
            "description": "cosine similarity in [-1, 1]."
          },
          {
            "field": "probs",
            "codec": "numpy",
            "shape": "(num_images, num_texts)",
            "when": "images and texts sent",
            "description": "softmax over the texts of logit_scale * similarity (zero-shot classification). Rows sum to 1."
          }
        ]
      },
      "constraints": [
        "At least one of `images` and `texts` is required; neither answers empty_request.",
