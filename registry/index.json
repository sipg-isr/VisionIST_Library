      "data": {
        "in": [
          {
            "field": "video",
            "kind": "b",
            "description": "One video file (mp4/avi/webm/mov). Mutually exclusive with images."
          },
          {
            "field": "images",
            "kind": "bb",
            "description": "Ordered frames, all the same size. Mutually exclusive with video."
          },
          {
            "field": "points",
            "kind": "ff",
            "description": "track: flat [u0, v0, u1, v1, ...] normalised query pixels in [0, 1]."
          }
        ],
        "out": [
          {
            "field": "query_uv",
            "codec": "numpy",
            "shape": "(Q, 2)",
            "when": "track, reconstruct",
            "description": "the normalised query pixels actually used, after gridding or capping"
          },
          {
            "field": "tracks_xyz_local",
            "codec": "numpy",
            "shape": "(Q, T, 3)",
            "when": "command=track",
            "description": "each query point's 3D position at frame t, in the camera frame of that same t"
          },
          {
            "field": "tracks_xyz_ref0",
            "codec": "numpy",
            "shape": "(Q, T, 3)",
            "when": "command=track",
            "description": "the same points in the camera frame of frame 0 - the one to use for motion"
          },
          {
            "field": "tracks_uv",
            "codec": "numpy",
            "shape": "(Q, T, 2)",
            "when": "command=track",
            "description": "2D reprojection, normalised like the input uv"
          },
          {
            "field": "tracks_visibility",
            "codec": "numpy",
            "shape": "(Q, T)",
            "when": "command=track",
            "description": "boolean, already thresholded from the model's logits"
          },
          {
            "field": "tracks_confidence",
            "codec": "numpy",
            "shape": "(Q, T)",
            "when": "command=track",
            "description": "raw scalar, meaningful for ranking rather than as a probability"
          },
          {
            "field": "points_xyz",
            "codec": "numpy",
            "shape": "(T, P, 3)",
            "when": "command=reconstruct",
            "description": "per-frame point cloud in the camera frame of frame 0; NaN where unresolved"
          },
          {
            "field": "points_visibility",
            "codec": "numpy",
            "shape": "(T, P)",
            "when": "command=reconstruct"
          },
          {
            "field": "points_confidence",
            "codec": "numpy",
            "shape": "(T, P)",
            "when": "command=reconstruct"
          },
          {
            "field": "intrinsics",
            "codec": "numpy",
            "shape": "(T, 3, 3)",
            "when": "command=cameras",
            "description": "per-frame K, least-squares from the query grid with a shared focal length"
