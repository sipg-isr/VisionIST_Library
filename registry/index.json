          {
            "field": "extrinsics",
            "codec": "numpy",
            "shape": "(T, 4, 4)",
            "when": "command=cameras",
            "description": "T_ref0_cam per frame, from pairwise Umeyama alignment"
          },
          {
            "field": "valid_intrinsics",
            "codec": "numpy",
            "shape": "(T,)",
            "when": "command=cameras",
            "description": "boolean - a frame whose fit did not converge is left as identity and marked false"
          },
          {
            "field": "valid_extrinsics",
            "codec": "numpy",
            "shape": "(T,)",
            "when": "command=cameras"
          }
        ]
      },
      "constraints": [
        "`images` and `video` are mutually exclusive; neither gives empty_request.",
        "At least 2 frames are required, and all images must share one size.",
        "Predictions are up to scale, not metric: every upstream evaluation aligns them to ground truth with a similarity transform before measuring. Do not read xyz as metres.",
        "Query timesteps are clamped to the model's clip_frames upstream rather than rejected, so asking about a frame beyond the clip returns a confident wrong answer. max_frames defaults to the clip length for that reason.",
