# Define workdir folder for all stages
# Must be renewed in the beggining of each stage
ARG WORKSPACE=/workspace
# SERVICE_NAME identifies the python file with the server
# The python file should have the name ${SERVICE_NAME}_service.py
# All boxes share the same proto file: pipeline.proto
ARG SERVICE_NAME=mediapipe


# --------------------------------------
# Builder stage to generate .proto files
# --------------------------------------

FROM python:3.10-slim@sha256:6ff506466f8b1e981719b468cc0023b8ef000b983cdec0eafe119d01f379e31d AS builder
## Renew build args
ARG WORKSPACE
ARG SERVICE_NAME

# Path for the protos folder to copy
ARG PROTOS_FOLDER_DIR=protos

RUN pip install --upgrade pip && \
    pip install grpcio grpcio-tools==1.74.0 protobuf

COPY ${PROTOS_FOLDER_DIR} ${WORKSPACE}/
WORKDIR ${WORKSPACE}

# Compile proto file and remove it
RUN python -m grpc_tools.protoc -I. --python_out=.  --grpc_python_out=. pipeline.proto


# --------------------------------------------------
# Builder stage to fetch the MediaPipe model bundles
# --------------------------------------------------
# The bundles are NOT in the pip wheel - MediaPipe Tasks downloads them
# separately - and a box must not reach the network at request time. So they
# are fetched once, here, and baked into the image. The same URLs are declared
# under `assets:` in box.yaml, which is how a checkout gets them for the tests
# (python3 tools/fetch_assets.py mediapipe).
#
# MODEL_VERSION is the upstream path segment. "latest" is what the MediaPipe
# documentation publishes and is a MOVING alias: build with --build-arg
# MODEL_VERSION=1 if you need two builds of this image to contain byte-identical
# weights.
FROM python:3.10-slim@sha256:6ff506466f8b1e981719b468cc0023b8ef000b983cdec0eafe119d01f379e31d AS models
ARG MODEL_VERSION=latest
ARG MODEL_BASE=https://storage.googleapis.com/mediapipe-models

COPY docker/fetch_models.py /fetch_models.py
RUN python3 /fetch_models.py /models


# -----------------------------
# Stage to generate final image
# -----------------------------

FROM python:3.10-slim@sha256:fd76ade0c607f27677bc04be3c60749f400eedc941d9e72967e19a4cedff80c2
# Renew build args
ARG WORKSPACE
ARG SERVICE_NAME

ARG USER=runner
ARG GROUP=runner-group
ARG SRC=src


# Create non-privileged user and workspace
RUN addgroup --system ${GROUP} && \
    adduser --system --no-create-home --ingroup ${GROUP} ${USER} && \
    mkdir -p ${WORKSPACE}/.mplcache && \
    chown -R ${USER}:${GROUP} ${WORKSPACE}

ENV XDG_CACHE_DIR=/workspace/.xcache
# Where the service looks for the .task bundles copied in below.
ENV MEDIAPIPE_MODEL_DIR=/workspace/models
# The runner user has no home, so matplotlib (pulled in by mediapipe's
# opencv-contrib dependency) warns and rebuilds its font cache every boot.
ENV MPLCONFIGDIR=/workspace/.mplcache

# Install requirements
# libgl1 / libglib2.0-0 are OpenCV's runtime shared libraries: mediapipe pulls
# opencv-contrib-python (not the headless build), so they are needed even
# though this box never opens a window.
#
# libegl1 / libgles2 are MediaPipe's own, and they are NOT optional on a
# CPU-only box: libmediapipe.so has DT_NEEDED entries for libEGL.so.1 and
# libGLESv2.so.2 on both amd64 and arm64, so the loader needs them before any
# task is created. Without them every command fails at create_from_options
# with "libEGL.so.1: cannot open shared object file". Still nothing CUDA.
COPY requirements.txt .
RUN apt update -y && \
    apt install -y --no-install-recommends \
        libgl1 libglib2.0-0 libegl1 libgles2 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    rm requirements.txt

# COPY .proto file to root to meet ai4eu specifications
COPY --from=builder --chown=${USER}:${GROUP} ${WORKSPACE}/pipeline.proto /

# Copy generated .py files to workspace
COPY --from=builder --chown=${USER}:${GROUP} ${WORKSPACE}/*.py ${WORKSPACE}/

# The model bundles, fetched in the `models` stage: ~55 MB for all five.
COPY --from=models --chown=${USER}:${GROUP} /models ${WORKSPACE}/models

# Copy the service file and the utils to workspace
# (rename service file to only service.py for generic usage)
COPY --chown=${USER}:${GROUP} ${SRC} ${WORKSPACE}
COPY --chown=${USER}:${GROUP} ${SRC}/${SERVICE_NAME}_service.py ${WORKSPACE}/service.py

# Change to non-privileged user
USER ${USER}

# Expose port 8061 according to ai4eu specifications
EXPOSE 8061

WORKDIR ${WORKSPACE}


CMD ["python3", "service.py"]
